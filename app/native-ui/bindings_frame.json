{
  "controller_type": "frame_controller",
  "name": "Cinema shortcuts",
  "description": "Cinema buttons while Steam renders the pointer.",
  "bindings": {
    "/actions/cinema": {
      "sources": [
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/cinema/in/right_a"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/cinema/in/right_b"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_down",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/cinema/in/left_a"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_right",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/cinema/in/left_b"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/cinema/in/right_stick"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/cinema/in/left_stick"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/cinema/in/right_grip"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/cinema/in/left_grip"
            }
          }
        }
      ]
    }
  }
}
